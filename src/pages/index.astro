---
// Landing page - Móveis Trindade
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Móveis Trindade – Montagem Profissional em Cascavel</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --orange: #E8600A;
    --orange-light: #FF7A1F;
    --dark: #2B2F38;
    --darker: #1A1D24;
    --gray: #4A4F5C;
    --light: #F5F0EB;
    --white: #FFFFFF;
    --card-bg: #F8F4EF;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Barlow', sans-serif;
    background: var(--white);
    color: var(--dark);
    overflow-x: hidden;
  }

  /* NAVBAR */
  nav {
    position: fixed; top: 0; width: 100%; z-index: 100;
    background: rgba(27, 30, 36, 0.95);
    backdrop-filter: blur(10px);
    padding: 14px 40px;
    display: flex; align-items: center; justify-content: space-between;
    border-bottom: 2px solid var(--orange);
  }

  .nav-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900; font-size: 1.5rem; color: var(--white);
    letter-spacing: 1px;
  }
  .nav-logo span { color: var(--orange); }

  .nav-cta {
    background: var(--orange);
    color: white; text-decoration: none;
    padding: 10px 22px; border-radius: 4px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700; font-size: 0.95rem; letter-spacing: 1px;
    transition: background 0.2s, transform 0.2s;
  }
  .nav-cta:hover { background: var(--orange-light); transform: translateY(-1px); }

  /* HERO */
  .hero {
    min-height: 100vh;
    background: var(--darker);
    display: flex; align-items: center;
    position: relative; overflow: hidden;
    padding: 100px 40px 60px;
  }

  .hero::before {
    content: '';
    position: absolute; top: 0; right: 0;
    width: 55%; height: 100%;
    background: linear-gradient(135deg, var(--orange) 0%, #C44A00 100%);
    clip-path: polygon(18% 0%, 100% 0%, 100% 100%, 0% 100%);
    opacity: 0.12;
  }

  .hero::after {
    content: '';
    position: absolute; top: -200px; right: -100px;
    width: 600px; height: 600px;
    border: 2px solid rgba(232, 96, 10, 0.15);
    border-radius: 50%;
  }

  .hero-inner {
    max-width: 1100px; margin: 0 auto; width: 100%;
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(232, 96, 10, 0.2);
    color: var(--orange);
    border: 1px solid rgba(232, 96, 10, 0.4);
    padding: 6px 16px; border-radius: 100px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.85rem; font-weight: 600; letter-spacing: 2px;
    text-transform: uppercase; margin-bottom: 20px;
    animation: fadeUp 0.6s ease both;
  }

  .hero h1 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 900; line-height: 1.0;
    color: var(--white);
    text-transform: uppercase;
    letter-spacing: -1px;
    margin-bottom: 20px;
    animation: fadeUp 0.6s ease 0.1s both;
  }

  .hero h1 span { color: var(--orange); }

  .hero p {
    font-size: 1.05rem; line-height: 1.7;
    color: rgba(255,255,255,0.7);
    margin-bottom: 36px;
    animation: fadeUp 0.6s ease 0.2s both;
  }

  .hero-btns {
    display: flex; gap: 14px; flex-wrap: wrap;
    animation: fadeUp 0.6s ease 0.3s both;
  }

  .btn-primary {
    background: var(--orange);
    color: white; text-decoration: none;
    padding: 16px 32px; border-radius: 4px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700; font-size: 1.1rem; letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px;
    box-shadow: 0 8px 30px rgba(232,96,10,0.35);
  }
  .btn-primary:hover { background: var(--orange-light); transform: translateY(-2px); box-shadow: 0 12px 40px rgba(232,96,10,0.45); }

  .btn-secondary {
    background: transparent;
    color: white; text-decoration: none;
    padding: 16px 32px; border-radius: 4px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700; font-size: 1.1rem; letter-spacing: 1px;
    text-transform: uppercase;
    border: 2px solid rgba(255,255,255,0.3);
    transition: all 0.2s;
  }
  .btn-secondary:hover { border-color: var(--orange); color: var(--orange); }

  /* Hero visual side */
  .hero-visual {
    display: flex; flex-direction: column; gap: 16px;
    animation: fadeUp 0.6s ease 0.4s both;
  }

  .stat-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-left: 3px solid var(--orange);
    border-radius: 8px;
    padding: 20px 24px;
    backdrop-filter: blur(10px);
  }

  .stat-card .number {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 2.2rem; font-weight: 900; color: var(--orange);
    line-height: 1;
  }

  .stat-card .label {
    font-size: 0.9rem; color: rgba(255,255,255,0.6); margin-top: 4px;
  }

  /* LOGO SECTION */
  .logo-section {
    background: var(--light);
    padding: 50px 40px;
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .logo-section img {
    max-height: 120px;
    filter: drop-shadow(0 4px 20px rgba(0,0,0,0.15));
  }

  /* TRUST BAR */
  .trust-bar {
    background: var(--dark);
    padding: 20px 40px;
    display: flex; justify-content: center; gap: 60px; flex-wrap: wrap;
  }
  .trust-item {
    display: flex; align-items: center; gap: 10px;
    color: rgba(255,255,255,0.8);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1rem; font-weight: 600; letter-spacing: 0.5px;
  }
  .trust-item .icon { font-size: 1.2rem; }

  /* SECTIONS COMMON */
  section { padding: 90px 40px; }
  .container { max-width: 1100px; margin: 0 auto; }

  .section-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 3px; text-transform: uppercase;
    color: var(--orange); margin-bottom: 12px;
  }

  .section-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900; text-transform: uppercase;
    color: var(--dark); line-height: 1.1;
    margin-bottom: 20px;
  }

  .section-title span { color: var(--orange); }

  /* COMPROMISE */
  .compromise {
    background: var(--white);
  }

  .compromise-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
  }

  .compromise p {
    font-size: 1.05rem; line-height: 1.8; color: var(--gray);
    margin-bottom: 16px;
  }

  .compromise-visual {
    background: var(--darker);
    border-radius: 12px; padding: 40px;
    position: relative; overflow: hidden;
  }

  .compromise-visual::before {
    content: '';
    position: absolute; bottom: -30px; right: -30px;
    width: 150px; height: 150px;
    background: var(--orange);
    border-radius: 50%; opacity: 0.15;
  }

  .big-quote {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 5rem; color: var(--orange); line-height: 0.8;
    margin-bottom: 16px; opacity: 0.6;
  }

  .compromise-visual p {
    color: rgba(255,255,255,0.85);
    font-size: 1.15rem; line-height: 1.7;
    font-style: italic;
  }

  .compromise-visual .author {
    margin-top: 16px;
    color: var(--orange);
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700; font-size: 1rem; letter-spacing: 1px;
    font-style: normal;
  }

  /* BENEFITS */
  .benefits { background: var(--light); }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px; margin-top: 50px;
  }

  .benefit-card {
    background: var(--white);
    border-radius: 10px;
    padding: 30px 24px;
    border-bottom: 3px solid transparent;
    transition: all 0.3s;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
  }

  .benefit-card:hover {
    border-bottom-color: var(--orange);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }

  .benefit-icon {
    font-size: 2rem; margin-bottom: 14px;
  }

  .benefit-card h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.2rem; font-weight: 800;
    text-transform: uppercase; color: var(--dark);
    margin-bottom: 10px; letter-spacing: 0.5px;
  }

  .benefit-card p {
    font-size: 0.9rem; color: var(--gray); line-height: 1.6;
  }

  /* TESTIMONIALS */
  .testimonials { background: var(--darker); }
  .testimonials .section-title { color: var(--white); }

  .testi-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px; margin-top: 50px;
  }

  .testi-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px; padding: 30px;
    position: relative;
    transition: transform 0.3s;
  }

  .testi-card:hover { transform: translateY(-4px); }

  .testi-card::before {
    content: '"';
    position: absolute; top: 16px; right: 20px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 4rem; color: var(--orange); opacity: 0.3; line-height: 1;
  }

  .stars { color: var(--orange); font-size: 1.1rem; margin-bottom: 14px; letter-spacing: 2px; }

  .testi-card p {
    color: rgba(255,255,255,0.8);
    font-size: 0.95rem; line-height: 1.7;
    margin-bottom: 20px;
  }

  .testi-author {
    display: flex; align-items: center; gap: 12px;
  }

  .author-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: linear-gradient(135deg, var(--orange), #C44A00);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900; color: white; font-size: 1.1rem;
  }

  .author-name {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700; color: var(--white); font-size: 1rem;
  }

  .author-city {
    font-size: 0.8rem; color: rgba(255,255,255,0.4);
  }

  /* GUARANTEE */
  .guarantee {
    background: var(--orange);
    text-align: center;
  }

  .guarantee .section-label { color: rgba(255,255,255,0.7); }
  .guarantee .section-title { color: var(--white); }

  .guarantee-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 100px; height: 100px;
    border: 3px solid rgba(255,255,255,0.4);
    border-radius: 50%;
    font-size: 3rem; margin-bottom: 24px;
    background: rgba(255,255,255,0.1);
  }

  .guarantee p {
    font-size: 1.1rem; color: rgba(255,255,255,0.9);
    max-width: 600px; margin: 0 auto; line-height: 1.7;
  }

  /* FAQ */
  .faq { background: var(--white); }

  .faq-list { margin-top: 50px; }

  .faq-item {
    border-bottom: 1px solid rgba(0,0,0,0.1);
    padding: 0;
    overflow: hidden;
  }

  .faq-q {
    width: 100%; text-align: left; background: none; border: none;
    cursor: pointer; padding: 24px 0;
    display: flex; justify-content: space-between; align-items: center;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.15rem; font-weight: 700;
    color: var(--dark); text-transform: uppercase; letter-spacing: 0.5px;
    transition: color 0.2s;
  }

  .faq-q:hover { color: var(--orange); }

  .faq-arrow {
    width: 28px; height: 28px;
    border: 2px solid var(--orange);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 1rem; color: var(--orange);
    transition: transform 0.3s;
  }

  .faq-item.open .faq-arrow { transform: rotate(180deg); }

  .faq-a {
    max-height: 0; overflow: hidden;
    transition: max-height 0.4s ease, padding 0.3s;
    font-size: 1rem; color: var(--gray); line-height: 1.7;
  }

  .faq-item.open .faq-a { max-height: 200px; padding-bottom: 20px; }

  /* CTA FINAL */
  .cta-final {
    background: var(--dark);
    text-align: center;
  }

  .cta-final .section-title { color: var(--white); }

  .cta-final p {
    font-size: 1.1rem; color: rgba(255,255,255,0.7);
    max-width: 550px; margin: 0 auto 36px;
    line-height: 1.7;
  }

  /* FOOTER */
  footer {
    background: var(--darker);
    padding: 40px 40px;
    text-align: center;
    border-top: 2px solid var(--orange);
  }

  .footer-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.8rem; font-weight: 900;
    color: var(--white); margin-bottom: 16px;
  }
  .footer-logo span { color: var(--orange); }

  .footer-info {
    color: rgba(255,255,255,0.5);
    font-size: 0.9rem; line-height: 2;
  }

  .footer-info a { color: var(--orange); text-decoration: none; }

  .footer-copy {
    margin-top: 24px;
    font-size: 0.8rem; color: rgba(255,255,255,0.25);
  }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal {
    opacity: 0; transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* WHATSAPP FLOAT */
  .whatsapp-float {
    position: fixed; bottom: 30px; right: 30px; z-index: 999;
    background: #25D366;
    color: white; text-decoration: none;
    width: 60px; height: 60px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 6px 20px rgba(37,211,102,0.45); }
    50% { transform: scale(1.08); box-shadow: 0 8px 30px rgba(37,211,102,0.6); }
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    nav { padding: 14px 20px; }
    .hero { padding: 100px 20px 60px; }
    .hero-inner { grid-template-columns: 1fr; gap: 40px; }
    .hero-visual { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .compromise-grid { grid-template-columns: 1fr; }
    section { padding: 70px 20px; }
    .trust-bar { gap: 24px; padding: 16px 20px; }
    footer { padding: 40px 20px; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-logo">MÓVEIS <span>TRINDADE</span></div>
  <a href="https://wa.me/5545998061813?text=Ol%C3%A1!%20Gostaria%20de%20um%20or%C3%A7amento." class="nav-cta">📲 Orçamento</a>
