    <div class="hero-visual">
      <div class="stat-card">
        <div class="number">30</div>
        <div class="label">Dias de Garantia por Escrito</div>
      </div>
      <div class="stat-card">
        <div class="number">100%</div>
        <div class="label">Satisfação dos Clientes</div>
      </div>
      <div class="stat-card">
        <div class="number">5+</div>
        <div class="label">Cidades Atendidas na Região</div>
      </div>
      <div class="stat-card">
